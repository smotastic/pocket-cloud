# Copy to .env and adjust. .env is git-ignored.

# Where every service stores its persistent data (bind mounts).
# Must be outside this repository and inside a path Colima mounts (default: $HOME).
DATA_ROOT=${HOME}/pocket-cloud-data

# --- gitea ---
GITEA_DOMAIN=localhost
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2222

# --- gitea-runner ---
# One-time registration token: docker exec gitea gitea actions generate-runner-token
GITEA_RUNNER_REGISTRATION_TOKEN=

# --- observability ---
GRAFANA_HTTP_PORT=3001
# Only applied on Grafana's first start; afterwards change it in the UI.
GRAFANA_ADMIN_PASSWORD=
# Prometheus UI and OTLP metrics receiver (/api/v1/otlp)
PROMETHEUS_PORT=9090

# --- bookmarks ---
# Image registry for own apps (Gitea's built-in container registry)
GITEA_REGISTRY=localhost:3000
# Image tag of bookmarks-server and bookmarks-web, e.g. 0.1.0
BOOKMARKS_VERSION=
BOOKMARKS_HTTP_PORT=3002
# Only applied when Postgres initialises its data directory.
BOOKMARKS_DB_PASSWORD=

# --- docmost ---
DOCMOST_HTTP_PORT=3003
# The address everyone opens, e.g. http://<mac-name>.local:3003 (used in invite links).
DOCMOST_APP_URL=http://localhost:3003
# Generate both with: openssl rand -hex 32
DOCMOST_APP_SECRET=
# Only applied when Postgres creates its database on the first start.
DOCMOST_DB_PASSWORD=

# --- backup (scripts/backup.sh) ---
# restic repository, e.g. on an external disk: /Volumes/<disk>/restic/pocket-cloud
RESTIC_REPOSITORY=
# Default: ~/.config/pocket-cloud/restic-password (created by `scripts/backup.sh init`)
#RESTIC_PASSWORD_FILE=
