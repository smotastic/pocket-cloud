<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. scripts/install-lens.sh replaces the __PLACEHOLDERS__ and
  installs the result to ~/Library/LaunchAgents/. Do not load this file directly.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.pocket-cloud.lens-run</string>
	<!-- The nightly batch: inbox, previews, tags, trash purge (pocket-lens spec 004). -->
	<key>ProgramArguments</key>
	<array>
		<string>__LENS_DIR__/bin/pocket-lens</string>
		<string>run</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>3</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/pocket-cloud/lens-run.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/pocket-cloud/lens-run.log</string>
</dict>
</plist>
