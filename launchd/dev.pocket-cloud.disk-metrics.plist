<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. scripts/install-disk-metrics.sh replaces the __PLACEHOLDERS__ and
  installs the result to ~/Library/LaunchAgents/. Do not load this file directly.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.pocket-cloud.disk-metrics</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__REPO_ROOT__/scripts/disk-metrics.sh</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__REPO_ROOT__</string>
	<!-- At login and every minute after. -->
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>60</integer>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/pocket-cloud/disk-metrics.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/pocket-cloud/disk-metrics.log</string>
</dict>
</plist>
