{
  "uid": "pocket-home-ingestor",
  "title": "Ingestor",
  "description": "The pocket-home ingestor: broker and gateway health, devices, ingestion, actions and the HTTP API.",
  "tags": ["pocket-home", "ingestor"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
