    {
      "id": 4,
      "type": "stat",
      "title": "Stale devices",
      "description": "Devices whose latest reading is older than the stale time of their kind; ignored devices are left out.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 9,
        "y": 1
