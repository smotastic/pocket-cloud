      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count((ingestor_device_stale_ratio{job=~\"$job\"} == 1) unless on (device) (ingestor_device_ignored_ratio{job=~\"$job\"} == 1)) or vector(0)",
          "range": false,
          "instant": true,
          "legendFormat": "Stale"
